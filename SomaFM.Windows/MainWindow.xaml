<Window x:Class="SomaFM.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SomaFM" Height="40" MinHeight="40" MaxHeight="40"
        SizeChanged="Window_SizeChanged"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>
    <DataTemplate x:Key="StationItemTemplate">
      <Button Click="StationItem_Click" MouseRightButtonUp="StationItem_MouseRightButtonUp" Cursor="Hand" Padding="0">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="6,3">
              <StackPanel Orientation="Horizontal">
                <Border Width="20" Height="20" CornerRadius="4" Background="#21272B"
                        ClipToBounds="True" Margin="0,0,8,0">
                  <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"
                           Foreground="#F3F5F7" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StreamInfo}" FontSize="9" Foreground="#9AA3A9"
                           VerticalAlignment="Center" Margin="6,1,0,0" />
                <TextBlock Text="{Binding PlayTime}" FontSize="9" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="6,1,0,0" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#1D2125" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>
    <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#000000" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#000000" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#171B1D" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="Transparent">
    <Border x:Name="BarSurface" Margin="2" Background="#101214" BorderBrush="#2B3034"
            BorderThickness="1" CornerRadius="9" MouseLeftButtonDown="BarSurface_MouseLeftButtonDown"
            PreviewMouseDown="BarSurface_PreviewMouseDown"
            PreviewMouseLeftButtonDown="BarSurface_PreviewMouseLeftButtonDown"
            PreviewMouseMove="BarSurface_PreviewMouseMove"
            PreviewMouseLeftButtonUp="BarSurface_PreviewMouseLeftButtonUp"
            MouseRightButtonUp="BarSurface_MouseRightButtonUp">
      <Grid Margin="8,2,8,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="LogoPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="0,0,8,0" Cursor="SizeAll"
                    ToolTip="Drag to move; release near a screen edge to snap">
          <TextBlock x:Name="AccentLogoText" Text="SOMA" Foreground="#F08A62" FontSize="10" FontWeight="Bold" />
          <TextBlock Text="FM" Foreground="#F3F5F7" FontSize="10" FontWeight="Bold" Margin="1,0,0,0" />
        </StackPanel>

        <Border x:Name="ArtworkBorder" Grid.Column="1" Width="22" Height="22" CornerRadius="5" Background="#1D2125"
                BorderBrush="#3E464B" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
          <Image x:Name="NowPlayingArtwork" Stretch="UniformToFill" />
        </Border>

        <Button x:Name="StationButton" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                HorizontalAlignment="Stretch"
                Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                HorizontalContentAlignment="Stretch" Click="StationButton_Click" ToolTip="Click to choose a station">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent" CornerRadius="3">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
          <StackPanel>
            <TextBlock x:Name="NowPlayingStation" Text="Choose a station" Foreground="#F3F5F7"
                       FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="NowPlayingTrack" Text="Live radio" Foreground="#9AA3A9"
                       FontSize="9" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </StackPanel>
        </Button>

        <Popup x:Name="StationPopup" Grid.Column="2" PlacementTarget="{Binding ElementName=StationButton}"
               Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" Opened="StationPopup_Opened">
          <Border Background="#101214" BorderBrush="#2B3034" BorderThickness="1" CornerRadius="9"
                  Margin="0,0,8,8" Width="260" MaxHeight="420" Padding="4"
                  MouseLeftButtonDown="StationPopup_MouseLeftButtonDown"
                  MouseRightButtonUp="StationPopup_MouseRightButtonUp">
            <Border.Effect>
              <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.5" />
            </Border.Effect>
            <DockPanel>
              <TextBox x:Name="StationSearchBox" DockPanel.Dock="Top" Margin="4,4,4,4" Padding="6,3"
                       Background="#171B1D" Foreground="#F3F5F7" BorderBrush="#3E464B"
                       CaretBrush="#F3F5F7" FontSize="11" ToolTip="Type to search stations"
                       TextChanged="StationSearchBox_TextChanged" KeyDown="StationSearchBox_KeyDown" />
              <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                  <TextBlock x:Name="FavoritesHeader" Text="FAVORITES" FontSize="9" FontWeight="Bold"
                             Foreground="{DynamicResource AccentBrush}" Margin="8,6,0,2" />
                  <ItemsControl x:Name="FavoritesList" ItemTemplate="{StaticResource StationItemTemplate}" />
                  <TextBlock x:Name="OtherStationsHeader" Text="ALL STATIONS" FontSize="9" FontWeight="Bold"
                             Foreground="{DynamicResource AccentBrush}" Margin="8,8,0,2" />
                  <ItemsControl x:Name="OtherStationsList" ItemTemplate="{StaticResource StationItemTemplate}" />
                  <TextBlock x:Name="NoMatchesText" Text="No matching stations" FontSize="10"
                             Foreground="#9AA3A9" Margin="8,6,0,6" Visibility="Collapsed" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Popup>

        <Border x:Name="VisualizerPanel" Grid.Column="3" Height="18" Padding="3,1" Margin="0,0,8,0"
                Background="#171B1D" CornerRadius="4" VerticalAlignment="Center" Cursor="Hand"
                ToolTip="Click to change color palette" MouseLeftButtonDown="VisualizerPanel_MouseLeftButtonDown">
          <UniformGrid x:Name="VisualizerBars" Rows="1" Columns="12" Width="72" />
        </Border>

        <TextBlock x:Name="ListeningTimeLabel" Grid.Column="4" Text="00:00:00" MinWidth="50" TextAlignment="Center"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="#C7CDD1" FontSize="9" FontWeight="SemiBold" Margin="0,0,8,0"
                   Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ListeningTimeLabel_MouseLeftButtonDown" />

        <Button x:Name="FavoriteButton" Grid.Column="5" Content="☆" Click="FavoriteButton_Click"
          Width="24" Height="24" Padding="0" VerticalAlignment="Center"
                Foreground="#D7DBDE" Background="Transparent" BorderThickness="0"
          FontFamily="Segoe UI Symbol" FontSize="18" FontWeight="Bold"
          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
          ToolTip="Favorite station" Margin="0,0,8,0" />

        <Slider x:Name="VolumeSlider" Grid.Column="6" Minimum="0" Maximum="100" Value="80"
                VerticalAlignment="Center" Width="88" Height="16" Margin="0,0,8,0"
                ToolTip="Volume" ValueChanged="VolumeSlider_ValueChanged" />

        <Button x:Name="OptionsButton" Grid.Column="7" Content="⚙" Click="OptionsButton_Click"
                Width="24" Height="22" Padding="0" VerticalAlignment="Center"
                Foreground="#C7CDD1" Background="Transparent" BorderThickness="0"
                FontFamily="Segoe UI Symbol" FontSize="14" ToolTip="Options" />

        <Button Grid.Column="8" Click="HideToTray_Click" Width="22" Height="22"
                Padding="0" VerticalAlignment="Center"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Foreground="#A8B1AF" Background="Transparent" BorderThickness="0"
                ToolTip="Minimize to notification area">
          <Rectangle Width="10" Height="2" Fill="#A8B1AF" VerticalAlignment="Bottom" Margin="0,0,0,6" />
        </Button>

        <Button Grid.Column="9" Content="×" Click="ExitApplication_Click" Width="22" Height="22"
                Margin="2,0,0,0" Padding="0" VerticalAlignment="Center"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Foreground="#A8B1AF" Background="Transparent" BorderThickness="0"
                FontSize="16" ToolTip="Quit SomaFM" />
      </Grid>
    </Border>
    <Thumb x:Name="LeftResizeThumb" HorizontalAlignment="Left" Width="6" Cursor="SizeWE"
           DragDelta="LeftResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
      <Thumb.Template>
        <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
      </Thumb.Template>
    </Thumb>
    <Thumb x:Name="RightResizeThumb" HorizontalAlignment="Right" Width="6" Cursor="SizeWE"
           DragDelta="RightResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
      <Thumb.Template>
        <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
      </Thumb.Template>
    </Thumb>
  </Grid>
</Window>